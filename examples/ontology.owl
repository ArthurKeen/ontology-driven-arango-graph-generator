<?xml version="1.0"?>
<!-- Minimal example ontology: people, organizations, and who works where. -->
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

  <owl:Ontology rdf:about="http://example.org/org">
    <rdfs:label>Example organization ontology</rdfs:label>
  </owl:Ontology>

  <owl:Class rdf:about="http://example.org/org#Person">
    <rdfs:label>Person</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/org#Employee">
    <rdfs:label>Employee</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://example.org/org#Person"/>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/org#Organization">
    <rdfs:label>Organization</rdfs:label>
  </owl:Class>

  <owl:ObjectProperty rdf:about="http://example.org/org#worksFor">
    <rdfs:label>works for</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/org#Employee"/>
    <rdfs:range rdf:resource="http://example.org/org#Organization"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://example.org/org#knows">
    <rdfs:label>knows</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/org#Person"/>
    <rdfs:range rdf:resource="http://example.org/org#Person"/>
  </owl:ObjectProperty>

  <owl:DatatypeProperty rdf:about="http://example.org/org#name">
    <rdfs:label>name</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
</rdf:RDF>
