# Safe example configuration. Copy this file to .arango and replace
# placeholder values with credentials for your local environment.
# .arango is git-ignored; never commit real credentials.

clusters:
  local_dev:
    type: "docker"
    name: "Local Development"
    container_name: "ontology-arango"
    endpoint: "http://localhost:8529"
    username: "root"
    password: "change-me"
    database: "graph_ontology"

  cloud_demo:
    type: "cloud"
    name: "Cloud Demo"
    endpoint: "https://example.arangodb.cloud:8529"
    username: "demo_user"
    # Read the password from an environment variable instead of this file
    password_env: "ARANGO_CLOUD_DEMO_PASSWORD"
    database: "graph_ontology"

default: "local_dev"
